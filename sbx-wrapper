#!/bin/bash
set -euo pipefail

die() {
    printf 'sbx-wrapper: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: sbx-opencode [--no-workspace] [NAME] [-- AGENT_ARGS...]
       sbx-copilot  [--no-workspace] [NAME] [-- AGENT_ARGS...]

Without NAME, reuse this folder's sandbox for the selected agent, or prompt
for a name and create one. With NAME, open an existing sandbox from anywhere.
Names such as "Project A" are converted to project-a.

--no-workspace skips folder lookup and creates a mountless sandbox with no
host folder attached. Without NAME, it prompts for a name; with NAME, it opens
that sandbox or creates it if it does not exist.

Every launch loads the registered xcode and exa MCP servers.
OpenCode is updated and migrated from V1 to V2; Copilot uses --sync-session=off.
OpenCode hides its free models and enables only the OpenRouter provider.
Defaults: OpenCode uses Haiku 5.5; Copilot uses Auto Balance.
Override MCP registration names with SBX_XCODE_MCP and SBX_EXA_MCP.
EOF
}

case "${0##*/}" in
    sbx-opencode) agent=opencode ;;
    sbx-copilot) agent=copilot ;;
    *)
        case "${1:-}" in
            opencode|copilot) agent=$1; shift ;;
            -h|--help) usage; exit 0 ;;
            *) die "Invoke as sbx-opencode or sbx-copilot (or bash sbx-wrapper AGENT)." ;;
        esac
        ;;
esac

no_workspace=
while [[ ${1:-} == --no-workspace ]]; do
    no_workspace=1
    shift
done
requested=
if [[ ${1:-} == -h || ${1:-} == --help ]]; then
    usage
    exit 0
fi
if [[ $# -gt 0 && $1 != -- ]]; then
    [[ $1 != -* && -n $1 ]] || die "Expected a sandbox name or -- before agent arguments."
    requested=$1
    shift
fi
if [[ $# -gt 0 ]]; then
    [[ $1 == -- ]] || die "Put -- before agent arguments."
    shift
fi
if [[ $agent == copilot ]]; then
    for arg in "$@"; do
        case "$arg" in
            --remote|--remote=*|--no-remote|--no-remote=*)
                die "Copilot removed --remote/--no-remote. Use /remote off in a session." ;;
            --connect|--connect=*|--host-environment|--host-environment=*|--host-ahp|--host-ahp=*)
                die "Remote connection and hosting options are disabled by this wrapper." ;;
            --sync-session|--sync-session=*)
                die "Session sync is disabled by this wrapper (--sync-session=off)." ;;
        esac
    done
fi

trap 'printf "sbx-wrapper: command failed at line %s (exit %s); launch aborted.\n" "$LINENO" "$?" >&2' ERR
for dependency in sbx jq; do
    command -v "$dependency" >/dev/null 2>&1 || die "Required command not found: $dependency"
done

normalize_name() {
    LC_ALL=C printf '%s' "$1" |
        LC_ALL=C tr '[:upper:]' '[:lower:]' |
        LC_ALL=C sed -E 's/[^a-z0-9.-]+/-/g; s/^[.-]+//; s/-+$//'
}

inventory=$(sbx ls --json)
if ! jq -e '
    type == "array" and all(.[];
        (.name | type == "string") and
        (.agent | type == "string") and
        ((.workspaces // []) | type == "array" and all(.[]; type == "string"))
    )
' <<<"$inventory" >/dev/null; then
    die "Unexpected sbx ls --json format; expected the sbx 0.48+ sandbox array."
fi

if [[ -n $requested ]]; then
    matches=$(jq --arg name "$requested" '[.[] | select(.name == $name)]' <<<"$inventory")
    if [[ $(jq length <<<"$matches") == 0 ]]; then
        normalized=$(normalize_name "$requested")
        matches=$(jq --arg name "$normalized" \
            '[.[] | select((.name | ascii_downcase) == $name)]' <<<"$inventory")
    fi
    if [[ $(jq length <<<"$matches") == 0 && -z $no_workspace ]]; then
        die "No sandbox named '$requested'. To create one, run without a name in its folder, or add --no-workspace."
    fi
elif [[ -z $no_workspace ]]; then
    workspace=$(pwd -P)
    matches=$(jq --arg agent "$agent" --arg workspace "$workspace" '
        [.[] | select(.agent == $agent and
            ((.workspaces // []) | index($workspace) != null))]
    ' <<<"$inventory")
else
    matches='[]'
fi

count=$(jq length <<<"$matches")
if [[ $count -gt 1 ]]; then
    printf 'Matching sandboxes:\n' >&2
    jq -r '.[].name' <<<"$matches" >&2
    die "Multiple matches. Choose one explicitly by name."
elif [[ $count == 1 ]]; then
    name=$(jq -r '.[0].name' <<<"$matches")
    existing_agent=$(jq -r '.[0].agent' <<<"$matches")
    [[ $existing_agent == "$agent" ]] ||
        die "'$name' uses $existing_agent, not $agent. Use the matching wrapper."
else
    if [[ -n $requested ]]; then
        label=$requested
    elif [[ -n $no_workspace ]]; then
        printf 'Sandbox name for a mountless %s sandbox: ' "$agent" >&2
        IFS= read -r label || die "Could not read a sandbox name."
    else
        printf 'Sandbox name for %s (%s): ' "$workspace" "$agent" >&2
        IFS= read -r label || die "Could not read a sandbox name."
    fi
    name=$(normalize_name "$label")
    [[ $name =~ ^[a-z0-9][a-z0-9.-]+$ && $name != default ]] ||
        die "Use at least two characters (letters/numbers); 'default' is reserved."
    if jq -e --arg name "$name" 'any(.[]; (.name | ascii_downcase) == $name)' \
        <<<"$inventory" >/dev/null; then
        die "Name '$name' is already taken. Open it explicitly or choose another name."
    fi
    printf 'Creating %s\n' "$name" >&2
    if [[ -n $no_workspace ]]; then
        sbx create --name "$name" "$agent"
    else
        sbx create --name "$name" "$agent" "$workspace"
    fi
fi

sbx mcp load "${SBX_XCODE_MCP:-xcode}" --sandbox "$name"
sbx mcp load "${SBX_EXA_MCP:-exa}" --sandbox "$name"

if [[ $agent == opencode ]]; then
    printf 'Updating OpenCode in %s...\n' "$name" >&2
    sbx exec "$name" bash -c '
        set -euo pipefail
        major_version() {
            local version
            version=$(opencode --version)
            if [[ $version =~ (^|[[:space:]])v?([0-9]+)\. ]]; then
                printf "%s\n" "${BASH_REMATCH[2]}"
            else
                printf "Cannot parse OpenCode version: %s\n" "$version" >&2
                return 1
            fi
        }
        opencode upgrade
        hash -r
        major=$(major_version)
        if [[ $major == 1 ]]; then
            opencode upgrade --major
            hash -r
        fi
        major=$(major_version)
        if [[ $major -lt 2 ]]; then
            printf "OpenCode migration did not install V2; launch aborted.\n" >&2
            exit 1
        fi
        opencode --version
    '
    provider_config='{"model":"openrouter/anthropic/claude-haiku-5.5","policies":[{"action":"provider.use","resource":"*","effect":"deny"},{"action":"provider.use","resource":"openrouter","effect":"allow"}]}'
    exec sbx run --name "$name" \
        -e OPENCODE_DISABLE_FREE_MODELS=1 \
        -e "OPENCODE_CONFIG_CONTENT=$provider_config" -- "$@"
else
    sbx exec "$name" copilot config --global model auto
    sbx exec "$name" copilot config --global autoTier balance
    exec sbx run --name "$name" -- --sync-session=off "$@"
fi
